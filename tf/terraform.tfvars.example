stream_pool_private_nsg_ocids            = []
stream_pool_private_endpoint_ip          = null

stream_name               = "fusion-audit-trail"
stream_partitions         = 1
stream_retention_in_hours = 24

connect_harness_name = "fusion-audit-connect"

